# Copy to .env and fill in real values. Never commit .env itself.

# SQLAlchemy database URL. Optional: defaults to a local SQLite file
# (sqlite:///./acme_salary_manager.db) if unset.
DATABASE_URL=

# Seeds 10,000 deterministic employees at startup, but only if the
# employees table is currently empty. Optional, off unless set to one of
# 1/true/yes/on (case-insensitive). Demo-only; see docs/deployment.md.
SEED_ON_EMPTY=false

# The one shared HR login. Required for login to ever succeed: if either
# is unset, every login attempt returns 401, regardless of what's submitted.
HR_USERNAME=
HR_PASSWORD=

# Signs and verifies login tokens. Required: the app fails to start at all
# if this is unset. Use a long, random value in any real deployment --
# rotating it invalidates every outstanding token at once.
AUTH_SECRET_KEY=

# Comma-separated list of origins allowed to call this API from a browser
# (e.g. https://acme-salary-manager.vercel.app). Optional: unset or empty
# means no origins are allowed, not "allow everything".
CORS_ALLOWED_ORIGINS=
